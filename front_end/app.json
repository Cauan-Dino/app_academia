{
  "expo": {
    "name": "TreinoPro",
    "slug": "treinopro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "treinopro",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.appacademia.treinopro"
    },
    "android": {
      "package": "com.appacademia.treinopro",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#121815"
      },
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#121815"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#121815"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "3ea112a0-c9a1-4579-ab03-25ebe7f6d0df"
      }
    },
    "owner": "cauan_penha"
  }
}
