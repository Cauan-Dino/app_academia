# Copie este arquivo para .env e preencha os valores.
# Nunca versione o .env preenchido.

# ---------- Banco de dados ----------
MYSQL_DATABASE=app_academia
MYSQL_USER=app_academia_user
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# Dentro do Docker o host é o nome do serviço (mysql). Fora, use 127.0.0.1:3307.
SQLALCHEMY_DATABASE_URL="mysql+aiomysql://app_academia_user:SENHA@mysql:3306/app_academia?charset=utf8mb4"

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------- Autenticação ----------
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
ALGORITHM=HS256
TEMPO_ACCESS_TOKEN=15        # minutos
TEMPO_REFRESH_TOKEN=7        # dias
# Segredo extra concatenado às senhas antes do hash
PEPPER=
# Assina os links enviados por e-mail (confirmação, troca de senha, exclusão)
EMAIL_TOKEN_SECRET_KEY=

# ---------- E-mail (Brevo) ----------
# O envio é pela API HTTPS do Brevo: o Railway bloqueia SMTP nos planos Trial e Hobby.
# Chave em app.brevo.com -> SMTP & API -> API Keys. Sem ela, os e-mails não são enviados
# (só aparece um erro no log).
BREVO_API_KEY=
# Remetente verificado em app.brevo.com -> Senders, domains & IPs -> Senders.
# Pode ser um Gmail, sem domínio próprio (alguns e-mails podem cair no spam).
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=TreinoPro

# ---------- Cadastro ----------
# E-mails que podem criar conta de personal, separados por vírgula.
# Vazio deixa o cadastro aberto para qualquer e-mail.
EMAILS_PERMITIDOS=

# ---------- Links dos e-mails ----------
# Endereço público da API, sem barra no final. No Railway: o domínio gerado em Networking.
API_PUBLIC_URL=http://localhost:8000

# ---------- WhatsApp Cloud API (Meta) ----------
# Painel: developers.facebook.com -> seu app -> WhatsApp
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=        # valor que você define e repete no painel da Meta
WHATSAPP_APP_SECRET=          # usado para validar a assinatura do webhook
WHATSAPP_API_VERSION=v26.0
PHONE_NUMBER_ID=
# Template aprovado na Meta, enviado ao aluno no cadastro.
# Precisa de 2 variáveis no corpo: {{1}} nome do aluno, {{2}} nome do personal.
WHATSAPP_TEMPLATE_BOAS_VINDAS=boas_vindas_app_academia
WHATSAPP_TEMPLATE_IDIOMA=pt_BR

# ---------- CORS ----------
# Origens de navegador liberadas, separadas por vírgula.
# Vazio bloqueia todo navegador. O app mobile e o webhook não passam por CORS.
CORS_ORIGINS=

# ---------- Observabilidade ----------
ES_HOST=elasticsearch
ES_PORT=9200
KIBANA_PORT=5601
ELASTIC_PASSWORD=
LOG_FILE_PATH=/logs/app.log

# ---------- Documentação da API ----------
# true liga o /docs (Swagger), o /openapi.json e o /login-form do botão "Authorize".
# Use true só na sua máquina; em produção deixe false (o /login-form não tem rate limit).
HABILITAR_DOCS=false
